<?xml version="1.0" ?>
<!--
  HomeFly Quad-X SITL world using the ArduPilot maze scene.

  Scene geometry is copied verbatim from ArduPilot/ardupilot_gz:
      ardupilot_gz_gazebo/worlds/maze.sdf
  (14 static walls plus a floor plane). It has no external model or
  texture dependencies, so a plain gz sim invocation loads it.

  The world name stays "quad" and the vehicle model stays "homefly"
  deliberately: the SITL bridge subscribes to
      /world/quad/model/homefly/link/body/sensor/imu/imu
  and publishes Actuators on /homefly/actuators (model name fallback).
  Renaming either breaks the bridge and the WiFi GCS four terminal setup.

  The vehicle is the stock HomeFly model from homefly_quad.world, copied
  verbatim so the verified control loop behaviour is unchanged. HomeFly is
  an attitude only controller: the maze is scenery, not a navigation test.
  Walls are solid collision bodies, so aggressive stick inputs can bump the
  vehicle and trip the IMU failsafe; use homefly_quad.world for clean
  attitude regression runs. The vehicle is parked in the open pocket near
  (2, 2) rather than the tighter origin pocket.

  Run with:
      gz sim -r -v4 tools/gazebo/homefly_maze.world
  or select this file through the SITL script's world option.
-->
<sdf version="1.9">
  <world name="quad">

    <!-- 1 kHz control loop: HomeFly expects exactly one IMU frame per
         control period (FlightConfig::control_period_us = 1000). -->
    <physics name="homefly_1khz" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <!-- Harmonic 8 needs the dedicated Imu system; gz-sim-sensors-system
         only handles rendering style sensors. -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -1</direction>
    </light>

    <model name='maze'>
      <static>1</static>
      <link name='Wall_0'>
        <pose degrees="true">-10 -10 0 0 0 90</pose>
        <collision name='Wall_0_Collision'>
          <pose>10 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>20 0.2 4</size>
            </box>
          </geometry>
        </collision>
        <visual name='Wall_0_Visual'>
          <pose>10 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>20 0.2 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='Wall_1'>
        <pose>-10 -10 0 0 0 0</pose>
        <collision name='Wall_1_Collision'>
          <pose>10 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>20 0.2 4</size>
            </box>
          </geometry>
        </collision>
        <visual name='Wall_1_Visual'>
          <pose>10 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>20 0.2 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='Wall_2'>
        <pose degrees="true">10 -10 0 0 0 90</pose>
        <collision name='Wall_2_Collision'>
          <pose>8.5 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>17 0.2 4</size>
            </box>
          </geometry>
        </collision>
        <visual name='Wall_2_Visual'>
          <pose>8.5 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>17 0.2 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='Wall_3'>
        <pose>-10 10 0 0 0 0</pose>
        <collision name='Wall_3_Collision'>
          <pose>10 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>20 0.2 4</size>
            </box>
          </geometry>
        </collision>
        <visual name='Wall_3_Visual'>
          <pose>10 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>20 0.2 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='Wall_4'>
        <pose>-7 -7 0 0 0 0</pose>
        <collision name='Wall_4_Collision'>
          <pose>8.5 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>17 0.2 4</size>
            </box>
          </geometry>
        </collision>
        <visual name='Wall_4_Visual'>
          <pose>8.5 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>17 0.2 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='Wall_5'>
        <pose degrees="true">-7 -7 0 0 0 90</pose>
        <collision name='Wall_5_Collision'>
          <pose>7 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>14 0.2 4</size>
            </box>
          </geometry>
        </collision>
        <visual name='Wall_5_Visual'>
          <pose>7 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>14 0.2 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='Wall_6'>
        <pose>-4 -4 0 0 0 0</pose>
        <collision name='Wall_6_Collision'>
          <pose>7 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>14 0.2 4</size>
            </box>
          </geometry>
        </collision>
        <visual name='Wall_6_Visual'>
          <pose>7 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>14 0.2 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='Wall_7'>
        <pose degrees="true">-4 -4 0 0 0 90</pose>
        <collision name='Wall_7_Collision'>
          <pose>4 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>8 0.2 4</size>
            </box>
          </geometry>
        </collision>
        <visual name='Wall_7_Visual'>
          <pose>4 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>8 0.2 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='Wall_8'>
        <pose>-1 -1 0 0 0 0</pose>
        <collision name='Wall_8_Collision'>
          <pose>5.5 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>11 0.2 4</size>
            </box>
          </geometry>
        </collision>
        <visual name='Wall_8_Visual'>
          <pose>5.5 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>11 0.2 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='Wall_9'>
        <pose degrees="true">-1 -1 0 0 0 90</pose>
        <collision name='Wall_9_Collision'>
          <pose>4 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>8 0.2 4</size>
            </box>
          </geometry>
        </collision>
        <visual name='Wall_9_Visual'>
          <pose>4 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>8 0.2 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='Wall_10'>
        <pose degrees="true">-4 7 0 0 0 90</pose>
        <collision name='Wall_10_Collision'>
          <pose>1.5 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>3 0.2 4</size>
            </box>
          </geometry>
        </collision>
        <visual name='Wall_10_Visual'>
          <pose>1.5 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>3 0.2 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='Wall_11'>
        <pose>-1 4 0 0 0 0</pose>
        <collision name='Wall_11_Collision'>
          <pose>1 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>2 0.2 4</size>
            </box>
          </geometry>
        </collision>
        <visual name='Wall_11_Visual'>
          <pose>1 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>2 0.2 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='Wall_12'>
        <pose>2 7 0 0 0 0</pose>
        <collision name='Wall_12_Collision'>
          <pose>4 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>8 0.2 4</size>
            </box>
          </geometry>
        </collision>
        <visual name='Wall_12_Visual'>
          <pose>4 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>8 0.2 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
          </material>
        </visual>
      </link>

      <link name='Wall_13'>
        <pose degrees="true">5 2 0 0 0 90</pose>
        <collision name='Wall_13_Collision'>
          <pose>2.5 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>5 0.2 4</size>
            </box>
          </geometry>
        </collision>
        <visual name='Wall_13_Visual'>
          <pose>2.5 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>5 0.2 4</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="homefly" canonical_link="body">
      <pose>2 2 0.2 0 0 0</pose>

      <link name="body">
        <inertial>
          <mass>0.8</mass>
          <inertia>
            <ixx>0.005</ixx><iyy>0.005</iyy><izz>0.009</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="body_visual">
          <geometry><box><size>0.20 0.20 0.05</size></box></geometry>
        </visual>
        <collision name="body_collision">
          <geometry><box><size>0.20 0.20 0.05</size></box></geometry>
        </collision>

        <!-- Only angular_velocity + linear_acceleration are consumed by the
             HomeFly complementary filter; no quaternion is needed. -->
        <sensor name="imu" type="imu">
          <topic>/world/quad/model/homefly/link/body/sensor/imu/imu</topic>
          <always_on>1</always_on>
          <update_rate>1000</update_rate>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>

      <!-- Quad-X rotor layout. motorNumber matches MotorMixer's Quad-X order;
           the bridge writes Actuators.velocity[motorNumber] in rad/s. -->
      <link name="rotor_0">
        <pose>0.17 0.17 0.02 0 0 0</pose>
        <inertial><mass>0.005</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>2e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.005</length></cylinder></geometry></visual>
      </link>
      <joint name="rotor_0_joint" type="revolute">
        <parent>body</parent><child>rotor_0</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <link name="rotor_1">
        <pose>0.17 -0.17 0.02 0 0 0</pose>
        <inertial><mass>0.005</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>2e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.005</length></cylinder></geometry></visual>
      </link>
      <joint name="rotor_1_joint" type="revolute">
        <parent>body</parent><child>rotor_1</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <link name="rotor_2">
        <pose>-0.17 -0.17 0.02 0 0 0</pose>
        <inertial><mass>0.005</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>2e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.005</length></cylinder></geometry></visual>
      </link>
      <joint name="rotor_2_joint" type="revolute">
        <parent>body</parent><child>rotor_2</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <link name="rotor_3">
        <pose>-0.17 0.17 0.02 0 0 0</pose>
        <inertial><mass>0.005</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>2e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.005</length></cylinder></geometry></visual>
      </link>
      <joint name="rotor_3_joint" type="revolute">
        <parent>body</parent><child>rotor_3</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <jointName>rotor_0_joint</jointName><linkName>rotor_0</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1000</maxRotVelocity><motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant><commandSubTopic>actuators</commandSubTopic>
        <motorNumber>0</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <jointName>rotor_1_joint</jointName><linkName>rotor_1</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1000</maxRotVelocity><motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant><commandSubTopic>actuators</commandSubTopic>
        <motorNumber>1</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <jointName>rotor_2_joint</jointName><linkName>rotor_2</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1000</maxRotVelocity><motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant><commandSubTopic>actuators</commandSubTopic>
        <motorNumber>2</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <jointName>rotor_3_joint</jointName><linkName>rotor_3</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1000</maxRotVelocity><motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant><commandSubTopic>actuators</commandSubTopic>
        <motorNumber>3</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
      </plugin>
    </model>
  </world>
</sdf>
