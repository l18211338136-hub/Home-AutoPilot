<?xml version="1.0" ?>
<!--
  HomeFly Quad-X SITL world using the verbatim ArduPilot airfield model.

  tools/gazebo/models/runway is a byte for byte copy of the COMPLETE
  ArduPilot/ardupilot_gazebo/models/runway directory: model.sdf,
  model.config, meshes/airfield.dae and all seven textures (28 MB; the five
  actually referenced by the SDF/DAE account for about 18 MB). Verified with
  cmp against upstream raw files. Gazebo resolves model://runway through
  GZ_SIM_RESOURCE_PATH. The SITL
  script exports that path automatically; for a manual GUI launch, export it
  yourself (see docs/gazebo.md section 8.9).

  The upstream runway.sdf places the strip at (-29, 545) for GPS navigation.
  Here the include sits at the origin so the vehicle and runway are both in
  the GUI viewport. Only the include pose differs from upstream; the model
  resources themselves are untouched.

  The world name stays "quad" and the vehicle model stays "homefly"
  deliberately: the SITL bridge subscribes to
      /world/quad/model/homefly/link/body/sensor/imu/imu
  and publishes Actuators on /homefly/actuators (model name fallback).
  Renaming either breaks the bridge and the WiFi GCS four terminal setup.

  The vehicle keeps the stock HomeFly link, sensor and plugin contract with
  unchanged physics; only the visuals are Iris styled.

  Run with:
      gz sim -r -v4 tools/gazebo/homefly_airport.world
  or select this file through the SITL script's world option.
-->
<sdf version="1.9">
  <world name="quad">

    <!-- 1 kHz control loop: HomeFly expects exactly one IMU frame per
         control period (FlightConfig::control_period_us = 1000). -->
    <physics name="homefly_1khz" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <!-- Harmonic 8 needs the dedicated Imu system; gz-sim-sensors-system
         only handles rendering style sensors. -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -1</direction>
    </light>

    <!-- Verbatim upstream ArduPilot runway model. Gazebo resolves
         model://runway through GZ_SIM_RESOURCE_PATH, exported automatically
         by run_wsl_sitl.sh. -->
    <include>
      <uri>model://runway</uri>
    </include>

    <model name="homefly" canonical_link="body">
      <pose>0 0 0.2 0 0 0</pose>

      <link name="body">
        <inertial>
          <mass>0.8</mass>
          <inertia>
            <ixx>0.005</ixx><iyy>0.005</iyy><izz>0.009</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <!-- 3DR Iris style airframe, visual geometry only. The collision
             box, inertial values, joints, IMU sensor and the four
             motor plugins below are unchanged, so the verified control
             loop behaviour carries over. -->
        <visual name="iris_pod">
          <geometry><box><size>0.16 0.12 0.045</size></box></geometry>
          <material><diffuse>0.11 0.12 0.14 1</diffuse></material>
        </visual>
        <visual name="iris_canopy">
          <pose>0 0 0.028 0 0 0</pose>
          <geometry><box><size>0.10 0.09 0.012</size></box></geometry>
          <material><diffuse>0.82 0.16 0.12 1</diffuse></material>
        </visual>
        <visual name="iris_arm_0">
          <pose degrees="true">0.085 0.085 0 0 0 45</pose>
          <geometry><box><size>0.24 0.018 0.012</size></box></geometry>
          <material><diffuse>0.16 0.17 0.19 1</diffuse></material>
        </visual>
        <visual name="iris_arm_1">
          <pose degrees="true">0.085 -0.085 0 0 0 -45</pose>
          <geometry><box><size>0.24 0.018 0.012</size></box></geometry>
          <material><diffuse>0.16 0.17 0.19 1</diffuse></material>
        </visual>
        <visual name="iris_arm_2">
          <pose degrees="true">-0.085 -0.085 0 0 0 45</pose>
          <geometry><box><size>0.24 0.018 0.012</size></box></geometry>
          <material><diffuse>0.16 0.17 0.19 1</diffuse></material>
        </visual>
        <visual name="iris_arm_3">
          <pose degrees="true">-0.085 0.085 0 0 0 -45</pose>
          <geometry><box><size>0.24 0.018 0.012</size></box></geometry>
          <material><diffuse>0.16 0.17 0.19 1</diffuse></material>
        </visual>
        <visual name="iris_motor_0">
          <pose>0.17 0.17 0.012 0 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.028</length></cylinder></geometry>
          <material><diffuse>0.30 0.31 0.33 1</diffuse></material>
        </visual>
        <visual name="iris_motor_1">
          <pose>0.17 -0.17 0.012 0 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.028</length></cylinder></geometry>
          <material><diffuse>0.30 0.31 0.33 1</diffuse></material>
        </visual>
        <visual name="iris_motor_2">
          <pose>-0.17 -0.17 0.012 0 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.028</length></cylinder></geometry>
          <material><diffuse>0.30 0.31 0.33 1</diffuse></material>
        </visual>
        <visual name="iris_motor_3">
          <pose>-0.17 0.17 0.012 0 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.028</length></cylinder></geometry>
          <material><diffuse>0.30 0.31 0.33 1</diffuse></material>
        </visual>
        <visual name="iris_skid_l">
          <pose>0 0.13 -0.13 0 0 0</pose>
          <geometry><box><size>0.30 0.014 0.014</size></box></geometry>
          <material><diffuse>0.20 0.21 0.23 1</diffuse></material>
        </visual>
        <visual name="iris_skid_r">
          <pose>0 -0.13 -0.13 0 0 0</pose>
          <geometry><box><size>0.30 0.014 0.014</size></box></geometry>
          <material><diffuse>0.20 0.21 0.23 1</diffuse></material>
        </visual>
        <visual name="iris_strut_0">
          <pose>0.1 0.13 -0.07 0 0 0</pose>
          <geometry><cylinder><radius>0.006</radius><length>0.12</length></cylinder></geometry>
          <material><diffuse>0.20 0.21 0.23 1</diffuse></material>
        </visual>
        <visual name="iris_strut_1">
          <pose>0.1 -0.13 -0.07 0 0 0</pose>
          <geometry><cylinder><radius>0.006</radius><length>0.12</length></cylinder></geometry>
          <material><diffuse>0.20 0.21 0.23 1</diffuse></material>
        </visual>
        <visual name="iris_strut_2">
          <pose>-0.1 0.13 -0.07 0 0 0</pose>
          <geometry><cylinder><radius>0.006</radius><length>0.12</length></cylinder></geometry>
          <material><diffuse>0.20 0.21 0.23 1</diffuse></material>
        </visual>
        <visual name="iris_strut_3">
          <pose>-0.1 -0.13 -0.07 0 0 0</pose>
          <geometry><cylinder><radius>0.006</radius><length>0.12</length></cylinder></geometry>
          <material><diffuse>0.20 0.21 0.23 1</diffuse></material>
        </visual>
        <collision name="body_collision">
          <geometry><box><size>0.20 0.20 0.05</size></box></geometry>
        </collision>

        <!-- Only angular_velocity + linear_acceleration are consumed by the
             HomeFly complementary filter; no quaternion is needed. -->
        <sensor name="imu" type="imu">
          <topic>/world/quad/model/homefly/link/body/sensor/imu/imu</topic>
          <always_on>1</always_on>
          <update_rate>1000</update_rate>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>

      <!-- Quad-X rotor layout. motorNumber matches MotorMixer's Quad-X order;
           the bridge writes Actuators.velocity[motorNumber] in rad/s. -->
      <link name="rotor_0">
        <pose>0.17 0.17 0.02 0 0 0</pose>
        <inertial><mass>0.005</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>2e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.012</radius><length>0.008</length></cylinder></geometry>
          <material><diffuse>0.30 0.31 0.33 1</diffuse></material>
        </visual>
        <visual name="prop_blade_a">
          <geometry><box><size>0.20 0.024 0.003</size></box></geometry>
          <material><diffuse>0.17 0.18 0.20 1</diffuse></material>
        </visual>
        <visual name="prop_blade_b">
          <pose degrees="true">0 0 0 0 0 90</pose>
          <geometry><box><size>0.20 0.024 0.003</size></box></geometry>
          <material><diffuse>0.17 0.18 0.20 1</diffuse></material>
        </visual>
        <visual name="prop_mark">
          <pose>0.075 0 0.003 0 0 0</pose>
          <geometry><box><size>0.04 0.024 0.002</size></box></geometry>
          <material><diffuse>0.82 0.16 0.12 1</diffuse></material>
        </visual>
      </link>
      <joint name="rotor_0_joint" type="revolute">
        <parent>body</parent><child>rotor_0</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <link name="rotor_1">
        <pose>0.17 -0.17 0.02 0 0 0</pose>
        <inertial><mass>0.005</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>2e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.012</radius><length>0.008</length></cylinder></geometry>
          <material><diffuse>0.30 0.31 0.33 1</diffuse></material>
        </visual>
        <visual name="prop_blade_a">
          <geometry><box><size>0.20 0.024 0.003</size></box></geometry>
          <material><diffuse>0.17 0.18 0.20 1</diffuse></material>
        </visual>
        <visual name="prop_blade_b">
          <pose degrees="true">0 0 0 0 0 90</pose>
          <geometry><box><size>0.20 0.024 0.003</size></box></geometry>
          <material><diffuse>0.17 0.18 0.20 1</diffuse></material>
        </visual>
        <visual name="prop_mark">
          <pose>0.075 0 0.003 0 0 0</pose>
          <geometry><box><size>0.04 0.024 0.002</size></box></geometry>
          <material><diffuse>0.90 0.90 0.92 1</diffuse></material>
        </visual>
      </link>
      <joint name="rotor_1_joint" type="revolute">
        <parent>body</parent><child>rotor_1</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <link name="rotor_2">
        <pose>-0.17 -0.17 0.02 0 0 0</pose>
        <inertial><mass>0.005</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>2e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.012</radius><length>0.008</length></cylinder></geometry>
          <material><diffuse>0.30 0.31 0.33 1</diffuse></material>
        </visual>
        <visual name="prop_blade_a">
          <geometry><box><size>0.20 0.024 0.003</size></box></geometry>
          <material><diffuse>0.17 0.18 0.20 1</diffuse></material>
        </visual>
        <visual name="prop_blade_b">
          <pose degrees="true">0 0 0 0 0 90</pose>
          <geometry><box><size>0.20 0.024 0.003</size></box></geometry>
          <material><diffuse>0.17 0.18 0.20 1</diffuse></material>
        </visual>
        <visual name="prop_mark">
          <pose>0.075 0 0.003 0 0 0</pose>
          <geometry><box><size>0.04 0.024 0.002</size></box></geometry>
          <material><diffuse>0.90 0.90 0.92 1</diffuse></material>
        </visual>
      </link>
      <joint name="rotor_2_joint" type="revolute">
        <parent>body</parent><child>rotor_2</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <link name="rotor_3">
        <pose>-0.17 0.17 0.02 0 0 0</pose>
        <inertial><mass>0.005</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>2e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.012</radius><length>0.008</length></cylinder></geometry>
          <material><diffuse>0.30 0.31 0.33 1</diffuse></material>
        </visual>
        <visual name="prop_blade_a">
          <geometry><box><size>0.20 0.024 0.003</size></box></geometry>
          <material><diffuse>0.17 0.18 0.20 1</diffuse></material>
        </visual>
        <visual name="prop_blade_b">
          <pose degrees="true">0 0 0 0 0 90</pose>
          <geometry><box><size>0.20 0.024 0.003</size></box></geometry>
          <material><diffuse>0.17 0.18 0.20 1</diffuse></material>
        </visual>
        <visual name="prop_mark">
          <pose>0.075 0 0.003 0 0 0</pose>
          <geometry><box><size>0.04 0.024 0.002</size></box></geometry>
          <material><diffuse>0.82 0.16 0.12 1</diffuse></material>
        </visual>
      </link>
      <joint name="rotor_3_joint" type="revolute">
        <parent>body</parent><child>rotor_3</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <jointName>rotor_0_joint</jointName><linkName>rotor_0</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1000</maxRotVelocity><motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant><commandSubTopic>actuators</commandSubTopic>
        <motorNumber>0</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <jointName>rotor_1_joint</jointName><linkName>rotor_1</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1000</maxRotVelocity><motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant><commandSubTopic>actuators</commandSubTopic>
        <motorNumber>1</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <jointName>rotor_2_joint</jointName><linkName>rotor_2</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1000</maxRotVelocity><motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant><commandSubTopic>actuators</commandSubTopic>
        <motorNumber>2</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <jointName>rotor_3_joint</jointName><linkName>rotor_3</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1000</maxRotVelocity><motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant><commandSubTopic>actuators</commandSubTopic>
        <motorNumber>3</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
      </plugin>
    </model>
  </world>
</sdf>
