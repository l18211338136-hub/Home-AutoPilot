<?xml version="1.0" ?>
<!--
  HomeFly Quad-X model fragment for Gazebo Garden / Harmonic (gz-sim).

  Copy the <model> element into your world SDF. This is a STARTING POINT:
  mass, inertia, rotor constants, joint names and topic names must be matched
  to your actual airframe and Gazebo release before the first SITL run.
  See docs/gazebo.md for the HomeFly side of the setup.

  Topics expected by tools/gazebo_bridge.py (backend gz):
    IMU      : /world/<world>/model/homefly/link/body/sensor/imu/imu
    Actuators: /actuators  (gz.msgs.Actuators.velocity, rad/s)
-->
<sdf version="1.9">
  <model name="homefly" canonical_link="body">
    <pose relative_to="world">0 0 0.2 0 0 0</pose>

    <link name="body">
      <inertial>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.005</ixx><iyy>0.005</iyy><izz>0.009</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="body_visual">
        <geometry><box><size>0.20 0.20 0.05</size></box></geometry>
      </visual>
      <collision name="body_collision">
        <geometry><box><size>0.20 0.20 0.05</size></box></geometry>
      </collision>

      <!-- 1 kHz IMU. HomeFly's complementary filter needs only angular
           velocity and linear acceleration (specific force, z ~= +g). -->
      <sensor name="imu" type="imu">
        <topic>/world/quad/model/homefly/link/body/sensor/imu/imu</topic>
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
        <imu>
          <angular_velocity><x><noise type="gaussian"><mean>0</mean><stddev>0.0</stddev></noise></x>
                             <y><noise type="gaussian"><mean>0</mean><stddev>0.0</stddev></noise></y>
                             <z><noise type="gaussian"><mean>0</mean><stddev>0.0</stddev></noise></z></angular_velocity>
          <linear_acceleration><x><noise type="gaussian"><mean>0</mean><stddev>0.0</stddev></noise></x>
                                <y><noise type="gaussian"><mean>0</mean><stddev>0.0</stddev></noise></y>
                                <z><noise type="gaussian"><mean>0</mean><stddev>0.0</stddev></noise></z></linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- Four rotors. motorNumber matches HomeFly MotorMixer Quad-X order.
         The bridge publishes normalized [0,1] thrust * max_rot_velocity
         (default 1000 rad/s) into Actuators.velocity[motorNumber]. -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>homefly</robotNamespace>
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>/actuators</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>homefly</robotNamespace>
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>/actuators</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>homefly</robotNamespace>
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>/actuators</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>homefly</robotNamespace>
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1000</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>/actuators</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <!-- NOTE: rotor links/joints and their poses are intentionally omitted.
         Add four <link name="rotor_N"> + <joint name="rotor_N_joint"
         type="revolute"> entries with the arm geometry of your airframe. -->
  </model>
</sdf>
