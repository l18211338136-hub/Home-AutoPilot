<?xml version="1.0" ?>
<!--
  HomeFly Quad-X SITL world for Gazebo Garden / Harmonic / Jetty (gz-sim).

  Unlike homefly_quad.sdf (a bare <model> fragment), this is a COMPLETE world:
  it includes the world systems, a 1 ms / 1 kHz physics step, ground plane and
  four rotor links + revolute joints required by MulticopterMotorModel.

  Start headless with:
      gz sim -s -v4 tools/gazebo/homefly_quad.world
  or let tools/run_wsl_sitl.sh (backend gz) start it for you.

  IMPORTANT: this world has NOT been executed against a real Gazebo install
  (the development host is Windows). Before the first real SITL run, check:
    * plugin filenames for your Gazebo release (gz-sim-*-system names vary),
    * the IMU topic must equal the bridge imu topic (default includes the
      world name "quad"),
    * commandSubTopic must NOT start with '/' when robotNamespace is set:
      gz builds `namespace + "/" + commandSubTopic` and AsValidTopic collapses
      the resulting "//", producing e.g. "homeflyactuators" instead of
      "/actuators". This world sets no robotNamespace and uses "actuators",
      so the MulticopterMotorModel plugins subscribe to "/actuators", which is
      exactly the bridge's default --motor-topic.
    * mass / inertia / rotor constants / arm geometry for your airframe,
    * Gazebo's event-driven IMU topic is not hard-lockstepped to HomeFly;
      see docs/gazebo.md section 4.3 for the pacing caveat.
  See docs/gazebo.md for the HomeFly side of the setup.
-->
<sdf version="1.9">
  <world name="quad">

    <!-- 1 kHz control loop: HomeFly expects exactly one IMU frame per
         control period (FlightConfig::control_period_us = 1000). -->
    <physics name="homefly_1khz" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <!-- Gazebo Sim 8 (Harmonic): IMU sensors are created by the dedicated
         Imu system, NOT by gz-sim-sensors-system (which only handles
         camera/lidar/thermal style rendering sensors). Without this plugin
         no IMU topic is ever published and the SITL bridge gets 0 frames. -->
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="homefly" canonical_link="body">
      <pose>0 0 0.2 0 0 0</pose>

      <link name="body">
        <inertial>
          <mass>0.8</mass>
          <inertia>
            <ixx>0.005</ixx><iyy>0.005</iyy><izz>0.009</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="body_visual">
          <geometry><box><size>0.20 0.20 0.05</size></box></geometry>
        </visual>
        <collision name="body_collision">
          <geometry><box><size>0.20 0.20 0.05</size></box></geometry>
        </collision>

        <!-- Only angular_velocity + linear_acceleration are consumed by the
             HomeFly complementary filter; no quaternion is needed. -->
        <sensor name="imu" type="imu">
          <topic>/world/quad/model/homefly/link/body/sensor/imu/imu</topic>
          <always_on>1</always_on>
          <update_rate>1000</update_rate>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>

      <!-- Quad-X rotor layout. motorNumber matches MotorMixer's Quad-X order;
           the bridge writes Actuators.velocity[motorNumber] in rad/s. -->
      <link name="rotor_0">
        <pose>0.17 0.17 0.02 0 0 0</pose>
        <inertial><mass>0.005</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>2e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.005</length></cylinder></geometry></visual>
      </link>
      <joint name="rotor_0_joint" type="revolute">
        <parent>body</parent><child>rotor_0</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <link name="rotor_1">
        <pose>0.17 -0.17 0.02 0 0 0</pose>
        <inertial><mass>0.005</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>2e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.005</length></cylinder></geometry></visual>
      </link>
      <joint name="rotor_1_joint" type="revolute">
        <parent>body</parent><child>rotor_1</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <link name="rotor_2">
        <pose>-0.17 -0.17 0.02 0 0 0</pose>
        <inertial><mass>0.005</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>2e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.005</length></cylinder></geometry></visual>
      </link>
      <joint name="rotor_2_joint" type="revolute">
        <parent>body</parent><child>rotor_2</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <link name="rotor_3">
        <pose>-0.17 0.17 0.02 0 0 0</pose>
        <inertial><mass>0.005</mass><inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>2e-6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.005</length></cylinder></geometry></visual>
      </link>
      <joint name="rotor_3_joint" type="revolute">
        <parent>body</parent><child>rotor_3</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <jointName>rotor_0_joint</jointName><linkName>rotor_0</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1000</maxRotVelocity><motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant><commandSubTopic>actuators</commandSubTopic>
        <motorNumber>0</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <jointName>rotor_1_joint</jointName><linkName>rotor_1</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1000</maxRotVelocity><motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant><commandSubTopic>actuators</commandSubTopic>
        <motorNumber>1</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <jointName>rotor_2_joint</jointName><linkName>rotor_2</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1000</maxRotVelocity><motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant><commandSubTopic>actuators</commandSubTopic>
        <motorNumber>2</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <jointName>rotor_3_joint</jointName><linkName>rotor_3</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>1000</maxRotVelocity><motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant><commandSubTopic>actuators</commandSubTopic>
        <motorNumber>3</motorNumber><rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
      </plugin>
    </model>
  </world>
</sdf>
